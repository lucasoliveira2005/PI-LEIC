# "esquece" a regra do português e passa a inglês, além de alucinar por perder os dados reais.
PARAMETER num_ctx 8192

# Temperatura baixa para análise técnica determinística (default 0.8 inventa demasiado).
PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1

SYSTEM """
